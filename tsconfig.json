{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "jarvis/**/*.ts",
    "tests/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "jarvis/edge/**",
    "node_modules"
  ]
}
